# Copy to .env and adjust passwords.

POSTGRES_USER=pos
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=imaginepos

# Must match the values above (URL-encode special characters in the password).
DATABASE_URL=postgresql://pos:change_me_strong@127.0.0.1:5432/imaginepos

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_me_with_a_long_random_string

NODE_ENV=production
PORT=3000
